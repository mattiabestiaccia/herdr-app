#!/bin/bash
# Builds this branch and installs it as ~/Applications/Herdr Personal.app,
# beside the official Herdr. Same home (~/.config/herdr-app) and core: use
# one app at a time. The previous install stays as "Herdr Personal.prev.app"
# for a one-command rollback:  install-personal --rollback
# Usage: install-personal [--from <binary> | --rollback]
set -euo pipefail

[[ $(uname -s) == Darwin ]] || { echo 'This installer requires macOS.' >&2; exit 1; }
cd "$(dirname "$0")/../.."

app="$HOME/Applications/Herdr Personal.app"
prev="$HOME/Applications/Herdr Personal.prev.app"
lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister

if [[ ${1:-} == --rollback ]]; then
    [[ -d $prev ]] || { echo "No previous install at $prev" >&2; exit 1; }
    rm -rf "$app.rollback"
    mv "$app" "$app.rollback"
    mv "$prev" "$app"
    mv "$app.rollback" "$prev"
    "$lsregister" -f "$app"
    echo "Rolled back. Quit and reopen Herdr Personal."
    exit 0
fi

# HERDR_PERSONAL: the core is kept current, the app never self-updates.
# CARGO_TARGET_DIR / ZIG may point at an offline build cache. `--from
# <binary>` installs a binary already built that way (same commit).
if [[ ${1:-} == --from ]]; then
    binary="${2:?--from needs a herdr-app binary}"
    [[ -x $binary ]] || { echo "Not an executable: $binary" >&2; exit 1; }
else
    HERDR_PERSONAL=1 cargo build --release --locked ${CARGO_FLAGS:-}
    binary="${CARGO_TARGET_DIR:-target}/release/herdr-app"
fi
version="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)"
commit="$(git rev-parse --short HEAD)"

stage="$(mktemp -d)/Herdr Personal.app"
mkdir -p "$stage/Contents/MacOS" "$stage/Contents/Resources"
cp "$binary" "$stage/Contents/MacOS/Herdr"
chmod +x "$stage/Contents/MacOS/Herdr"
cp assets/icons/Herdr.icns "$stage/Contents/Resources/Herdr.icns"
cat > "$stage/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Herdr</string>
    <key>CFBundleIdentifier</key><string>personal.herdr.app</string>
    <key>CFBundleName</key><string>Herdr Personal</string>
    <key>CFBundleDisplayName</key><string>Herdr Personal</string>
    <key>CFBundleIconFile</key><string>Herdr</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version-personal</string>
    <key>CFBundleVersion</key><string>$commit</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in Herdr can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in Herdr can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in Herdr can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict/></dict></plist>
PLIST
# Finder does not inherit a login shell's PATH; hc must still be discoverable.
/usr/libexec/PlistBuddy -c "Add :LSEnvironment:PATH string $HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin" "$stage/Contents/Info.plist"
codesign --force --sign - "$stage"
codesign --verify --deep --strict "$stage"

mkdir -p "$HOME/Applications"
if [[ -d $app ]]; then
    rm -rf "$prev"
    mv "$app" "$prev"
fi
mv "$stage" "$app"
"$lsregister" -f "$app" || echo "Could not register with Launch Services; Finder will find it anyway."
echo "Installed $app ($version-personal, $commit). Quit Herdr and open Herdr Personal."
